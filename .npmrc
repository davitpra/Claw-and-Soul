# @shopify/polaris 13 declara `react@^18` como peer y el proyecto va con React
# 19. En local se instala igual porque el ~/.npmrc de desarrollo lleva
# legacy-peer-deps; sin este fichero, el `npm ci` de Vercel revalida los peers y
# aborta con ERESOLVE. Se queda hasta que Polaris soporte React 19.
legacy-peer-deps=true
